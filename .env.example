# Browser Reliability Engineering Lab (BREL) - Environment Configuration

# Browser Configuration
BROWSER=chrome
HEADLESS=true
BROWSER_TIMEOUT=15
IMPLICIT_WAIT=0

# Target Application URLs
INTERNET_APP_URL=https://the-internet.herokuapp.com
UITAP_APP_URL=http://uitestingplayground.com
CONTROLLED_APP_URL=http://127.0.0.1:8000

# Controlled Application Configuration
CONTROLLED_APP_HOST=127.0.0.1
CONTROLLED_APP_PORT=8000

# Reliability Engine Configuration
EXPERIMENT_OUTPUT_DIR=reports/reliability
ARTIFACTS_DIR=artifacts
DEFAULT_ITERATIONS=10
RANDOM_SEED=42

# Parallel Execution
MAX_PARALLEL_WORKERS=4
